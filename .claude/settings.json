{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Read", "Edit", "Write", "Glob", "Grep", "Bash"],
    "deny": [
      "Read(**/.env)", "Write(**/.env)", "Edit(**/.env)",
      "Read(**/.config.yml)", "Write(**/.config.yml)", "Edit(**/.config.yml)",
      "Bash(git push --force *)",
      "Bash(rm -rf /*)"
    ],
    "additionalDirectories": ["/private/tmp"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}}'"
          }
        ]
      }
    ]
  }
}