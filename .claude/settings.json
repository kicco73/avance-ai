{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:googleapis.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(unzip *)",
      "Bash(lsof *)",
      "Bash(jobs *)",
      "Bash(kill %*)",
      "Bash(echo *)",
      "Bash(npm *)",
      "Bash(python3 *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pip *)",
      "Bash(.venv/bin/uvicorn *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(backend/.venv/bin/python *)",
      "Bash(backend/.venv/bin/pip *)",
      "Bash(rm -rf **/__pycache__)",
      "Bash(rm -f /tmp/*.log)"
    ],
    "deny": [
      "Read(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Read(**/.config.yml)",
      "Write(**/.config.yml)",
      "Edit(**/.config.yml)",
      "Bash(git push --force *)"
    ],
    "additionalDirectories": [
      "/private/tmp"
    ]
  }
}